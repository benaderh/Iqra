<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <quran.hb.com.quran.NoSwipeViewPager
        android:id="@+id/vPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
    />

    <!-- Vue PDF continue pour le mode paysage -->
    <quran.hb.com.quran.ContinuousPageView
        android:id="@+id/continuousView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
    />



    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <Button
            android:id="@+id/btnF"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="0.7"
            android:background="#1d0606"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true"
            android:drawableLeft="@android:drawable/ic_menu_search" />

       <Button
            android:id="@+id/btnW"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:text="ورش"
            android:layout_weight="1"
            android:background="#1d0606"
            android:textColor="#aea7a7"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnH"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:text="حفص"
            android:textStyle="bold"
            android:layout_weight="1"
            android:background="#1d0606"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnT"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:text="تفسير"
            android:background="#1d0606"
            android:layout_weight="1"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:text="تلاوة"
            android:background="#227e08"
            android:layout_weight="1"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnM"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:text="القائمة"
            android:background="#1d0606"
            android:layout_weight="1"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/ll1"
        android:layout_alignParentRight="true"
        >
    <Button
        android:id="@+id/btnAbout"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:text="حول"
        android:background="#1d0606"
        android:layout_weight="0.06"
        android:textColor="#ffffff"
        android:textAlignment="center"
        android:visibility="gone"
        android:onClick="true" />
    </LinearLayout>


       <LinearLayout
        android:id="@+id/ll21"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#FFF4CB"
        android:visibility="gone"
        android:layout_alignParentTop="true"
        >

        <ScrollView
            android:id="@+id/scrollV"
            android:layout_weight="1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll111"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <TextView

                    android:id="@+id/tv_aya"
                    android:text="آية"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#41e70e"
                    android:background="#000000"
                    android:textSize="25sp"
                    />

                <TextView
                    android:id="@+id/tv_tefcir"
                    android:text="تفسير"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"

                    />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"

                    android:layout_gravity="center_horizontal|bottom"

                    >

                    <Button
                        android:id="@+id/btnAN"
                        android:layout_width="110dp"
                        android:layout_height="50dp"

                        android:textAlignment="center"

                        android:onClick="true"
                        android:text="الآية التالية"

                        />

                    <Button
                        android:id="@+id/btnRetour"
                        android:layout_width="110dp"
                        android:layout_height="50dp"

                        android:textAlignment="center"

                        android:onClick="true"
                        android:text="العودة"

                        />

                    <Button
                        android:id="@+id/btnAP"
                        android:layout_width="110dp"
                        android:layout_height="50dp"


                        android:onClick="true"
                        android:layout_gravity="right"
                        android:text="الآية السابقة"

                        />

                </LinearLayout>


            </LinearLayout>
        </ScrollView>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFF4CB"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        >

        <ScrollView
            android:id="@+id/scrollVb"
            android:layout_weight="1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll222"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <TextView

                    android:id="@+id/tv_ayab"
                    android:text="آية"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#41e70e"
                    android:background="#000000"
                    android:textSize="25sp"
                    />


                <TextView
                    android:id="@+id/tv_tefcirb"
                    android:text="تفسير"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"

                    />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="220dp"
                    android:layout_height="50dp"

                    android:layout_gravity="center_horizontal|bottom"

                    >

                    <Button
                       android:id="@+id/btnANb"
                       android:layout_width="110dp"
                       android:layout_height="50dp"

                       android:textAlignment="center"

                       android:onClick="true"
                        android:text="الآية التالية"

                    />

                    <Button
                        android:id="@+id/btnAPb"
                        android:layout_width="110dp"
                        android:layout_height="50dp"


                        android:onClick="true"
                        android:layout_gravity="right"
                        android:text="الآية السابقة"

                    />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>




    <LinearLayout
        android:id="@+id/ll2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <Button
            android:id="@+id/btnS"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="42dp"
            android:text="Sora"
            android:textColor="#ffffff"
            android:background="#1d0606"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="🎤"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:background="#1d0606"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnP"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Page"
            android:textColor="#ffffff"
            android:textAlignment="center"
            android:textSize="14sp"
            android:background="#1d0606"
            android:visibility="gone"
            android:onClick="true" />

        <Button
            android:id="@+id/btnJ"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:text="Jouz"
            android:textColor="#ffffff"
            android:background="#1d0606"
            android:textSize="14sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:onClick="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/cadre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:background="#44521400"
        android:textSize="25dp"

       />


</RelativeLayout>


